+  if (now_ms < next_controller_sync_ms_) {
+    return;
+  }
+  next_controller_sync_ms_ = now_ms + 250;
+  int gamepad_count = 0;
+  SDL_JoystickID* gamepad_ids = SDL_GetGamepads(&gamepad_count);
