+/**
+ * @file        tests/unit/graphics/texture_fetch_constant_test.cpp
+ * @brief       Texture fetch constant field layout regression tests
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <catch2/catch_test_macros.hpp>
+#include <rex/graphics/xenos.h>
+
+namespace xenos = rex::graphics::xenos;
+
+// The Vulkan SPIR-V fetch translator applies the sampled value exponent bias
+// (`exp_adjust`) from bits 13:18 of fetch constant word 3. Word 4 bits 13:18
+// are the upper bits of the LOD bias and must not be used as the exponent
+// adjustment - doing so scales every texture sample by a power of two and was
+// the cause of the Diablo III menu font alpha loss and the black scene.
+TEST_CASE("Texture fetch exp_adjust is separate from LOD bias", "[graphics][texture]") {
+  // Diablo III menu font atlas fetch constant (base 0x10F07, k_8, tiled).
+  xenos::xe_gpu_texture_fetch_t fetch = {};
+  fetch.dword_3 = 0x00000248;  // num_format 0, swizzle 0x124, exp_adjust 0
+  fetch.dword_4 = 0x003F4000;  // lod_bias -12 (1/32 units)
+
+  CHECK(fetch.swizzle == 0x124);
+  CHECK(fetch.exp_adjust == 0);
+  CHECK(fetch.lod_bias == -12);
+
+  // D3D12's translator uses word 3, bits 13:18 for the result exponent bias.
+  const auto extract_exp_adjust = [](uint32_t word) {
+    return int32_t(word << 13) >> 26;
+  };
+  CHECK(extract_exp_adjust(fetch.dword_3) == 0);
+  // Word 4 bits 13:18 contain the high part of lod_bias (here -6), which must
+  // never be applied as a result scale.
+  CHECK(extract_exp_adjust(fetch.dword_4) == -6);
+}
