+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <catch2/catch_session.hpp>
+
+#include <cstdlib>
+
+// The runtime's static teardown is not safe to run after the test session
+// (some global registries are destroyed twice through the test link). Exit
+// directly once Catch2 has reported the result - this also keeps
+// catch_discover_tests' `--list-tests` invocation from crashing.
+int main(int argc, char** argv) {
+  const int result = Catch::Session().run(argc, argv);
+  std::_Exit(result);
+}
