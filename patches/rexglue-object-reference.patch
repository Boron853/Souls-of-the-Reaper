+// Enumerators have X_KENUMERATOR bodies, not dispatch headers. Looking them
+// up through GetNativeObject's dispatch-header fallback overwrites their
+// close_message/user_index fields with a synthetic event signature/handle.
+static object_ref<XObject> LookupReferencedNativeObject(uint32_t native_ptr) {
+  for (auto& enumerator : REX_KERNEL_OBJECTS()->GetObjectsByType<XEnumerator>()) {
+    if (enumerator->guest_object() == native_ptr) {
+      return object_ref<XObject>(enumerator.release());
+    }
+  }
+  return XObject::GetNativeObject<XObject>(
+      REX_KERNEL_STATE(), REX_KERNEL_MEMORY()->TranslateVirtual(native_ptr));
+}
+
+void ObReferenceObject_entry(u32 native_ptr) {
+  // Match ObDereferenceObject: guest users of native object pointers must
+  // keep the owning handle alive, including XAM's private enumerators.
+  if (native_ptr == 0xDEADF00D) {
+    return;
+  }
+  auto object = LookupReferencedNativeObject(native_ptr);
+  if (object) {
+    object->RetainHandle();
+  }
+}
+
 u32 ObDereferenceObject_entry(u32 native_ptr) {
   REXKRNL_IMPORT_TRACE("ObDereferenceObject", "ptr={:#x}", (uint32_t)native_ptr);
   // Check if a dummy value from ObReferenceObjectByHandle.
@@ -161,8 +187,7 @@ u32 ObDereferenceObject_entry(u32 native_ptr) {
