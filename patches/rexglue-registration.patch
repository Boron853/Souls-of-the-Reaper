+void FunctionGraph::notifyPendingFunctions(FunctionNode* added,
+                                           const std::vector<FunctionNode*>& pending) {
+  for (auto* node : pending) {
+    if (node != added && node->isPending()) {
+      node->tryResolveAgainst(added);
+    }
+  }
+}
+
+std::vector<uint32_t> FunctionGraph::findAbsorbedGapFunctions() const {
+  struct Range { uint32_t start, end, owner; };
+  std::vector<Range> protectedRanges, gapRanges;
+  for (const auto& [base, node] : functions_) {
+    auto& ranges = node->authority() == FunctionAuthority::GAP_FILL ? gapRanges : protectedRanges;
+    auto addRange = [&](uint32_t start, uint32_t end) {
+      start = std::max(start, base);
+      end = std::min(end, base + node->size());
+      if (start < end) ranges.push_back({start, end, base});
+    };
+    if (node->blocks().empty() || node->authority() == FunctionAuthority::CONFIG ||
+        node->authority() == FunctionAuthority::PDATA) {
+      addRange(base, base + node->size());
+    } else {
+      for (const auto& block : node->blocks()) addRange(block.base, block.base + block.size);
+    }
+  }
+  auto byStart = [](const Range& a, const Range& b) { return a.start < b.start; };
+  std::sort(protectedRanges.begin(), protectedRanges.end(), byStart);
+  std::sort(gapRanges.begin(), gapRanges.end(), byStart);
+  size_t protectedIndex = 0, gapIndex = 0;
+  uint32_t protectedEnd = 0, gapEnd = 0;
+  std::vector<uint32_t> absorbed;
+  // The base index is ordered, so prefix maxima answer containment queries.
+  for (const auto& [base, node] : functionsByBase_) {
+    if (node->authority() != FunctionAuthority::GAP_FILL) continue;
+    while (protectedIndex < protectedRanges.size() && protectedRanges[protectedIndex].start <= base)
+      protectedEnd = std::max(protectedEnd, protectedRanges[protectedIndex++].end);
+    uint32_t ownEnd = 0;
+    while (gapIndex < gapRanges.size() && gapRanges[gapIndex].start <= base) {
+      const auto& range = gapRanges[gapIndex++];
+      if (range.owner < base) gapEnd = std::max(gapEnd, range.end);
+      else ownEnd = std::max(ownEnd, range.end);
+    }
+    if (protectedEnd > base || gapEnd > base) absorbed.push_back(base);
+    // A gap never absorbs itself; its ranges apply only to later entrypoints.
+    gapEnd = std::max(gapEnd, ownEnd);
+  }
+  return absorbed;
+}
+
 }  // namespace rex::codegen
