diff --git a/src/core/socket_win.cpp b/src/core/socket_win.cpp
--- a/src/core/socket_win.cpp
+++ b/src/core/socket_win.cpp
@@ -14,6 +14,20 @@
 }
 
 int socket_ioctl(SocketHandle handle, uint32_t cmd, uint8_t* arg) {
+  // Guest arguments are big-endian u_long values.
+  constexpr uint32_t kFionread = 0x4004667F;
+  constexpr uint32_t kFionbio = 0x8004667E;
+  if (arg && (cmd == kFionbio || cmd == kFionread)) {
+    u_long value = (u_long(arg[0]) << 24) | (u_long(arg[1]) << 16) | (u_long(arg[2]) << 8) | u_long(arg[3]);
+    const int ret = ioctlsocket(static_cast<SOCKET>(handle), cmd, &value);
+    if (ret == 0 && cmd == kFionread) {
+      arg[0] = uint8_t(value >> 24);
+      arg[1] = uint8_t(value >> 16);
+      arg[2] = uint8_t(value >> 8);
+      arg[3] = uint8_t(value);
+    }
+    return ret;
+  }
   return ioctlsocket(static_cast<SOCKET>(handle), cmd, reinterpret_cast<u_long*>(arg));
 }
 
diff --git a/src/core/socket_posix.cpp b/src/core/socket_posix.cpp
--- a/src/core/socket_posix.cpp
+++ b/src/core/socket_posix.cpp
@@ -3,6 +3,7 @@
 
 static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC, "This file is POSIX-only");
 
+#include <fcntl.h>
 #include <sys/ioctl.h>
 #include <unistd.h>
 
@@ -13,7 +14,34 @@
 }
 
 int socket_ioctl(SocketHandle handle, uint32_t cmd, uint8_t* arg) {
-  return ioctl(static_cast<int>(handle), cmd, arg);
+  const int fd = static_cast<int>(handle);
+  // Guest commands are WinSock values and the argument is a big-endian u_long; the numeric ioctl
+  // codes only coincide with the host's on BSD/macOS, so translate them explicitly.
+  constexpr uint32_t kFionread = 0x4004667F;
+  constexpr uint32_t kFionbio = 0x8004667E;
+  if (cmd == kFionbio && arg) {
+    int flags = fcntl(fd, F_GETFL, 0);
+    if (flags < 0) {
+      return -1;
+    }
+    const uint32_t enable = (uint32_t(arg[0]) << 24) | (uint32_t(arg[1]) << 16) |
+                            (uint32_t(arg[2]) << 8) | uint32_t(arg[3]);
+    flags = enable ? (flags | O_NONBLOCK) : (flags & ~O_NONBLOCK);
+    return fcntl(fd, F_SETFL, flags);
+  }
+  if (cmd == kFionread && arg) {
+    int available = 0;
+    const int ret = ioctl(fd, FIONREAD, &available);
+    if (ret == 0) {
+      const uint32_t v = static_cast<uint32_t>(available);
+      arg[0] = uint8_t(v >> 24);
+      arg[1] = uint8_t(v >> 16);
+      arg[2] = uint8_t(v >> 8);
+      arg[3] = uint8_t(v);
+    }
+    return ret;
+  }
+  return ioctl(fd, cmd, arg);
 }
 
