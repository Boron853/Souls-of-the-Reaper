+
+void VulkanCommandProcessor::EvaluateDynamicResolution() {
+  if (!REXCVAR_GET(d3_dynamic_resolution) || !dynamic_resolution_initialized_ ||
+      dynamic_resolution_change_pending_ ||
+      dynamic_resolution_max_scale_ <= dynamic_resolution_min_scale_) {
+    return;
+  }
+  if (!dynamic_resolution_sample_count_) {
+    return;
+  }
+
+  int32_t target_fps = REXCVAR_GET(d3_dynamic_resolution_target_fps);
+  if (target_fps <= 0) {
+    target_fps = 60;
+  }
+  const int64_t budget_ns = int64_t(1000000000LL) / target_fps;
+  const int64_t average_ns =
+      dynamic_resolution_sample_sum_ns_ / int64_t(dynamic_resolution_sample_count_);
+  using namespace std::chrono;
+  const int64_t now_ns =
+      duration_cast<nanoseconds>(steady_clock::now().time_since_epoch()).count();
+  constexpr int64_t kMinChangeIntervalNs = 1500000000LL;
+  if (dynamic_resolution_last_change_ns_ &&
+      now_ns - dynamic_resolution_last_change_ns_ < kMinChangeIntervalNs) {
+    return;
+  }
+
+  // Downscale when the measured work exceeds the frame budget by 10% for a
+  // sustained window. The scale change itself is applied at the swap boundary.
+  if (average_ns > budget_ns + budget_ns / 10 &&
+      dynamic_resolution_current_scale_ > dynamic_resolution_min_scale_) {
+    RequestDrawResolutionScale(dynamic_resolution_current_scale_ - 1);
+    dynamic_resolution_last_change_ns_ = now_ns;
+    // Avoid immediately probing the scale that just failed.
+    dynamic_resolution_upscale_block_until_ns_ = now_ns + 30000000000LL;
+    return;
+  }
+
+  // Upscale only when the current work is comfortably below the budget and the
+  // projected cost of the next scale still fits. This prevents the common
+  // 720p-at-105-FPS -> 1440p-at-34-FPS oscillation on GPUs that cannot sustain
+  // the higher scale.
+  if (average_ns < budget_ns * 3 / 4 &&
+      dynamic_resolution_current_scale_ < dynamic_resolution_max_scale_ &&
+      dynamic_resolution_upscale_block_until_ns_ <= now_ns &&
+      (!dynamic_resolution_last_change_ns_ ||
+       now_ns - dynamic_resolution_last_change_ns_ >= 5000000000LL)) {
+    const uint64_t current_scale = dynamic_resolution_current_scale_;
+    const uint64_t next_scale = current_scale + 1;
+    const double area_ratio =
+        double(next_scale * next_scale) / double(current_scale * current_scale);
+    if (double(average_ns) * area_ratio <= double(budget_ns) * 0.9) {
+      RequestDrawResolutionScale(dynamic_resolution_current_scale_ + 1);
+      dynamic_resolution_last_change_ns_ = now_ns;
+    }
+  }
+}
+
+void VulkanCommandProcessor::RequestDrawResolutionScale(uint32_t scale) {
+  if (scale < dynamic_resolution_min_scale_ || scale > dynamic_resolution_max_scale_ ||
+      scale == dynamic_resolution_current_scale_ || dynamic_resolution_change_pending_) {
+    return;
+  }
+  dynamic_resolution_pending_scale_ = scale;
+  dynamic_resolution_change_pending_ = true;
+  REXGPU_INFO("[D3 dynamic resolution] scale {}x -> {}x requested",
+              dynamic_resolution_current_scale_, scale);
+}
+
+bool VulkanCommandProcessor::ApplyPendingDrawResolutionScale() {
+  if (!dynamic_resolution_change_pending_) {
+    return true;
+  }
+  if (!REXCVAR_GET(d3_dynamic_resolution) || !dynamic_resolution_initialized_) {
+    dynamic_resolution_change_pending_ = false;
+    return true;
+  }
+  if (submission_open_ || frame_open_) {
+    return false;
+  }
+  if (dynamic_resolution_pending_scale_ == dynamic_resolution_current_scale_) {
+    dynamic_resolution_change_pending_ = false;
+    return true;
+  }
+  if (!AwaitAllQueueOperationsCompletion()) {
+    return false;
+  }
+
+  const uint32_t new_scale = dynamic_resolution_pending_scale_;
+  if (!ReinitializeDrawResolutionCaches(new_scale, new_scale)) {
+    REXGPU_ERROR("[D3 dynamic resolution] Failed to switch to {}x; disabling", new_scale);
+    dynamic_resolution_change_pending_ = false;
+    dynamic_resolution_initialized_ = false;
+    return false;
+  }
+
+  dynamic_resolution_current_scale_ = new_scale;
+  dynamic_resolution_pending_scale_ = new_scale;
+  dynamic_resolution_change_pending_ = false;
+  dynamic_resolution_sample_sum_ns_ = 0;
+  dynamic_resolution_sample_count_ = 0;
+  REXGPU_INFO("[D3 dynamic resolution] scale {}x active", new_scale);
+  return true;
+}
+
+bool VulkanCommandProcessor::ReinitializeDrawResolutionCaches(uint32_t scale_x,
+                                                             uint32_t scale_y) {
+  if (!register_file_ || !shared_memory_ || !shared_memory_binding_count_) {
+    return false;
+  }
+
+  // The pipeline cache references the render target cache and the texture cache
+  // keeps guest textures; all three contain state derived from the scale.
+  texture_cache_.reset();
+  pipeline_cache_.reset();
+  render_target_cache_.reset();
+  ClearTransientDescriptorPools();
+
+  std::unique_ptr<VulkanRenderTargetCache> new_render_target_cache =
+      std::make_unique<VulkanRenderTargetCache>(*register_file_, *memory_, scale_x, scale_y, *this);
+  if (!new_render_target_cache->Initialize(shared_memory_binding_count_)) {
+    REXGPU_ERROR("[D3 dynamic resolution] Failed to initialize render target cache at {}x", scale_x);
+    return false;
+  }
+
+  std::unique_ptr<VulkanPipelineCache> new_pipeline_cache =
+      std::make_unique<VulkanPipelineCache>(*this, *register_file_, *new_render_target_cache,
+                                            guest_shader_vertex_stages_);
+  if (!new_pipeline_cache->Initialize()) {
+    REXGPU_ERROR("[D3 dynamic resolution] Failed to initialize pipeline cache at {}x", scale_x);
+    return false;
+  }
+  if (shader_storage_initialized_) {
+    new_pipeline_cache->InitializeShaderStorage(shader_storage_cache_root_,
+                                                shader_storage_title_id_,
+                                                shader_storage_blocking_);
+  }
+
+  std::unique_ptr<VulkanTextureCache> new_texture_cache = VulkanTextureCache::Create(
+      *register_file_, *shared_memory_, scale_x, scale_y, *this, guest_shader_pipeline_stages_);
+  if (!new_texture_cache) {
+    REXGPU_ERROR("[D3 dynamic resolution] Failed to initialize texture cache at {}x", scale_x);
+    return false;
+  }
+
+  render_target_cache_ = std::move(new_render_target_cache);
+  pipeline_cache_ = std::move(new_pipeline_cache);
+  texture_cache_ = std::move(new_texture_cache);
+
+  // The EDRAM storage buffer belongs to the render target cache.
+  UpdateSharedMemoryAndEdramDescriptorSet();
+
+  // The next submission resets these, but clear them explicitly so a stale
+  // handle cannot be observed if a swap is skipped.
+  current_render_pass_ = VK_NULL_HANDLE;
+  current_framebuffer_ = nullptr;
+  in_render_pass_ = false;
+  current_guest_graphics_pipeline_ = VK_NULL_HANDLE;
+  current_external_graphics_pipeline_ = VK_NULL_HANDLE;
+  current_external_compute_pipeline_ = VK_NULL_HANDLE;
+  current_guest_graphics_pipeline_layout_ = nullptr;
+  deferred_command_buffer_.Reset();
+  return true;
+}
+
+void VulkanCommandProcessor::UpdateSharedMemoryAndEdramDescriptorSet() {
+  if (!render_target_cache_ ||
+      render_target_cache_->GetPath() != RenderTargetCache::Path::kPixelShaderInterlock ||
+      shared_memory_and_edram_descriptor_set_ == VK_NULL_HANDLE) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkDescriptorBufferInfo edram_descriptor_buffer_info;
+  edram_descriptor_buffer_info.buffer = render_target_cache_->edram_buffer();
+  edram_descriptor_buffer_info.offset = 0;
+  edram_descriptor_buffer_info.range = VK_WHOLE_SIZE;
+  VkWriteDescriptorSet write_descriptor_set_edram{};
+  write_descriptor_set_edram.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  write_descriptor_set_edram.dstSet = shared_memory_and_edram_descriptor_set_;
+  write_descriptor_set_edram.dstBinding = 1;
+  write_descriptor_set_edram.dstArrayElement = 0;
+  write_descriptor_set_edram.descriptorCount = 1;
+  write_descriptor_set_edram.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  write_descriptor_set_edram.pBufferInfo = &edram_descriptor_buffer_info;
+  dfn.vkUpdateDescriptorSets(vulkan_device->device(), 1, &write_descriptor_set_edram, 0, nullptr);
 }
 
