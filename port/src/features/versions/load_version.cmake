# Loads one game-version profile (versions/<id>.json) and writes the header the
# optional PC features compile against. This is the only place version-specific
# guest addresses live: adding a game build means adding one JSON file here.
#
#   souls_load_feature_version(<id> <out_header> <out_hash> <out_symbols>)
#
# Sets <out_hash> to the expected Default.xex SHA-256 and <out_symbols> to the
# guest function symbols the generated code must contain.
function(souls_load_feature_version id out_header out_hash out_symbols)
    set(_file "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/${id}.json")
    if(NOT EXISTS "${_file}")
        message(FATAL_ERROR "No PC-feature version profile for '${id}': expected ${_file}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}")
    file(READ "${_file}" _json)

    string(JSON _hash GET "${_json}" executable_sha256)
    set(_h "// Generated by versions/load_version.cmake from ${id}.json. Do not edit.\n#pragma once\n#include <cstdint>\n\n")
    set(_symbols "")

    string(JSON _count LENGTH "${_json}" functions)
    math(EXPR _last "${_count} - 1")
    foreach(_i RANGE ${_last})
        string(JSON _name MEMBER "${_json}" functions ${_i})
        string(JSON _addr GET "${_json}" functions "${_name}" address)
        string(JSON _hook GET "${_json}" functions "${_name}" hook)
        string(TOUPPER "${_addr}" _addr)
        string(LENGTH "${_addr}" _addr_length)
        if(NOT _addr MATCHES "^[0-9A-F]+$" OR NOT _addr_length EQUAL 8)
            message(FATAL_ERROR "${id}.json: function '${_name}' has invalid address '${_addr}'")
        endif()
        string(APPEND _h "#define D3_FN_${_name} sub_${_addr}\n#define D3_IMP_${_name} __imp__sub_${_addr}\n")
        # Hooks are defined by us and call the original through __imp__; the
        # rest are plain guest functions we call.
        if(_hook)
            string(APPEND _h "DECLARE_REX_FUNC(__imp__sub_${_addr});\n")
        else()
            string(APPEND _h "DECLARE_REX_FUNC(sub_${_addr});\n")
        endif()
        list(APPEND _symbols "sub_${_addr}")
    endforeach()

    # Leading instruction words (masked, see scripts/find_feature_addresses.py)
    # that the executable's code at each function must still match at runtime.
    string(APPEND _h "\nnamespace d3::features::version {\nstruct CodeSignature {\n  uint32_t address;\n  uint32_t count;\n  uint32_t words[12];\n};\ninline constexpr CodeSignature kCodeSignatures[] = {\n")
    string(JSON _count LENGTH "${_json}" functions)
    math(EXPR _last "${_count} - 1")
    set(_signed 0)
    foreach(_i RANGE ${_last})
        string(JSON _name MEMBER "${_json}" functions ${_i})
        string(JSON _type ERROR_VARIABLE _err TYPE "${_json}" functions "${_name}" signature)
        if(NOT _type STREQUAL "ARRAY")
            continue()
        endif()
        string(JSON _addr GET "${_json}" functions "${_name}" address)
        string(JSON _n LENGTH "${_json}" functions "${_name}" signature)
        if(_n GREATER 12)
            message(FATAL_ERROR "${id}.json: signature for '${_name}' is longer than 12 words")
        endif()
        math(EXPR _end "${_n} - 1")
        set(_words "")
        foreach(_w RANGE ${_end})
            string(JSON _word GET "${_json}" functions "${_name}" signature ${_w})
            string(APPEND _words "0x${_word}u, ")
        endforeach()
        string(APPEND _h "    {0x${_addr}u, ${_n}, {${_words}}},\n")
        math(EXPR _signed "${_signed} + 1")
    endforeach()
    string(APPEND _h "    {0, 0, {}},\n};\ninline constexpr unsigned kCodeSignatureCount = ${_signed};\n\n")
    string(JSON _count LENGTH "${_json}" data)
    math(EXPR _last "${_count} - 1")
    foreach(_i RANGE ${_last})
        string(JSON _name MEMBER "${_json}" data ${_i})
        string(JSON _addr GET "${_json}" data "${_name}" address)
        string(APPEND _h "inline constexpr uint32_t ${_name} = 0x${_addr}u;\n")
    endforeach()
    string(JSON _count LENGTH "${_json}" layout)
    math(EXPR _last "${_count} - 1")
    foreach(_i RANGE ${_last})
        string(JSON _name MEMBER "${_json}" layout ${_i})
        string(JSON _value GET "${_json}" layout "${_name}")
        string(APPEND _h "inline constexpr uint32_t ${_name} = ${_value}u;\n")
    endforeach()
    string(APPEND _h "} // namespace d3::features::version\n")

    set(_out "${CMAKE_CURRENT_BINARY_DIR}/souls_generated/pc_features_version.h")
    file(WRITE "${_out}.tmp" "${_h}")
    file(COPY_FILE "${_out}.tmp" "${_out}" ONLY_IF_DIFFERENT)
    file(REMOVE "${_out}.tmp")
    set(${out_header} "${_out}" PARENT_SCOPE)
    set(${out_hash} "${_hash}" PARENT_SCOPE)
    set(${out_symbols} "${_symbols}" PARENT_SCOPE)
endfunction()
