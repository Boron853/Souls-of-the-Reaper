# Game assets - DO NOT include (copyrighted)
game/
D3_Portable/

# ReXGlue SDK - clone separately and apply patches/ (see README)
rexglue-sdk/
sdk-bin/
sdk/
# Installer-managed pinned SDK checkout (used when rexglue-sdk/ is absent or
# at a different revision)
.install/

# Build outputs
port/out/
port/generated/
port/ttd/

# Third-party tools
tools/

# Installer build output (installer/SoulsOfTheReaper.iss is the only part of
# installer/ meant to be versioned; ISCC.exe compiles it straight from
# port/out/build, launcher/dist and tools/)
installer/dist/
installer/payload/
installer/Imagenes/

# Launcher build output/binaries - only source (Launcher.ps1, build_launcher.ps1,
# v6_borderless_final.html) is versioned. The compiled exe, icon, and the
# WebView2 SDK redistributable DLLs are binaries, not code - get them locally
# (see README) and build_launcher.ps1 embeds them into the exe.
launcher/dist/
launcher/lib/
launcher/*.ico
SoulsOfTheReaper.exe

# Game/build icon (binary asset patched into diablo3.exe post-build by
# tools/set_game_icon.ps1 - see README)
ico_game.ico

*.zip

